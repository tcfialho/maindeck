+static long ms_since(const struct timespec *then, const struct timespec *now) {
+	return (now->tv_sec - then->tv_sec) * 1000L + (now->tv_nsec - then->tv_nsec) / 1000000L;
+}
+
+static void arm_focus_nudge(struct Window *window) {
+	g_nudge_window = window;
+	g_nudge_armed = window != NULL;
+	clock_gettime(CLOCK_MONOTONIC, &g_nudge_armed_at);
+}
+
+static void disarm_focus_nudge(void) {
+	g_nudge_armed = false;
+	g_nudge_window = NULL;
+}
+
+// Roda a cada volta do loop (não só no timeout de poll: com eventos Wayland
+// chegando o tempo todo o branch de timeout pode nunca rodar). Retorna true se
+// marcou um nudge, p/ o chamador pedir manage_dirty e o render cycle o enviar.
+bool process_nudge_timer(void) {
+	if (!g_nudge_armed) return false;
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (ms_since(&g_nudge_armed_at, &now) < DOUBLE_TAP_MS) return false;
+	struct Window *armed = g_nudge_window;
+	disarm_focus_nudge();
+	struct Window *target = target_window();
+	if (target == NULL || target != armed || target->closed) return false;
+	target->pending_nudge = true;
+	return true;
+}
